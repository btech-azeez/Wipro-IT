@page "{id:int}"
@model EmployeeManagement.Pages.Employees.DetailsModel
@{
    ViewData["Title"] = "Employee Profile";
    var e = Model.Employee;
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var canSeePayroll = role is "CEO" or "HR";

    var colors = new Dictionary<string,string>
    {
        ["CEO"]="linear-gradient(135deg,#f7b731,#f39c12)",
        ["HR"]="linear-gradient(135deg,#e94560,#c0392b)",
        ["Manager"]="linear-gradient(135deg,#4B4BF7,#6C3FC8)",
        ["Employee"]="linear-gradient(135deg,#20bf6b,#0a3d62)"
    };
    var avBg = colors.ContainsKey(e.Role) ? colors[e.Role] : "#ccc";
    var ini = $"{(e.FirstName.Length>0?e.FirstName[0]:' ')}{(e.LastName.Length>0?e.LastName[0]:' ')}";
    var tenure = (DateTime.UtcNow - e.DateOfJoining).Days;
    var years = tenure / 365; var months = (tenure % 365) / 30;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-person-badge-fill me-2 text-primary"></i>Employee Profile</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-page="/Employees/Index" class="text-decoration-none">Employees</a></li>
            <li class="breadcrumb-item active">@e.FirstName @e.LastName</li>
        </ol></nav>
    </div>
    <div class="d-flex gap-2">
        @if (role is "CEO" or "HR" or "Manager")
        {
            <a asp-page="/Employees/Edit" asp-route-id="@e.EmployeeId" class="btn btn-wipro">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
        }
        <a asp-page="/Employees/Index" class="btn btn-wipro-outline">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left: Profile card -->
    <div class="col-lg-4">
        <div class="wipro-card text-center mb-4">
            <div style="background:linear-gradient(135deg,#1a1a2e,#4B4BF7);padding:2.5rem 1.5rem 1rem;border-radius:12px 12px 0 0;">
                <div class="emp-avatar mx-auto mb-3" style="width:80px;height:80px;font-size:1.8rem;background:@avBg;color:white;">
                    @ini
                </div>
                <h4 style="color:white;font-weight:700;margin:0;">@e.FirstName @e.LastName</h4>
                <p style="color:rgba(255,255,255,0.7);margin:4px 0;">@e.Designation</p>
                <span class="role-badge role-@e.Role">@e.Role</span>
            </div>
            <div class="card-body">
                <div class="row g-3 text-start">
                    <div class="col-6">
                        <div style="font-size:0.72rem;color:#94a3b8;text-transform:uppercase;font-weight:600;">Wipro ID</div>
                        <code style="font-size:0.82rem;">@e.WiproEmployeeId</code>
                    </div>
                    <div class="col-6">
                        <div style="font-size:0.72rem;color:#94a3b8;text-transform:uppercase;font-weight:600;">Status</div>
                        <span class="badge @(e.IsActive ? "status-active" : "status-inactive")">@(e.IsActive ? "Active" : "Inactive")</span>
                    </div>
                    <div class="col-6">
                        <div style="font-size:0.72rem;color:#94a3b8;text-transform:uppercase;font-weight:600;">Tenure</div>
                        <div style="font-weight:600;font-size:0.85rem;">@years yr @months mo</div>
                    </div>
                    <div class="col-6">
                        <div style="font-size:0.72rem;color:#94a3b8;text-transform:uppercase;font-weight:600;">Location</div>
                        <div style="font-weight:600;font-size:0.85rem;">@(e.WorkLocation ?? "—")</div>
                    </div>
                    @if (canSeePayroll)
                    {
                        <div class="col-12">
                            <div style="font-size:0.72rem;color:#94a3b8;text-transform:uppercase;font-weight:600;">Annual CTC</div>
                            <div style="font-weight:700;font-size:1.1rem;color:#4B4BF7;">₹@String.Format("{0:N0}", e.Salary)</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Details -->
    <div class="col-lg-8">
        <div class="wipro-card mb-4">
            <div class="card-body">
                <h6 style="font-weight:700;border-bottom:1px solid #f1f5f9;padding-bottom:0.5rem;margin-bottom:1rem;">
                    <i class="bi bi-person me-2 text-primary"></i>Personal Information
                </h6>
                <div class="row g-3">
                    @foreach (var row in new[]{
                        ("Email",       e.Email),
                        ("Phone",       e.PhoneNumber ?? "—"),
                        ("Gender",      e.Gender ?? "—"),
                        ("Blood Group", e.BloodGroup ?? "—"),
                        ("Date of Birth", e.DateOfBirth.HasValue ? e.DateOfBirth.Value.ToString("dd MMM yyyy") : "—"),
                        ("Address",     e.Address ?? "—")
                    })
                    {
                        <div class="col-md-6">
                            <div style="font-size:0.72rem;color:#94a3b8;font-weight:600;text-transform:uppercase;">@row.Item1</div>
                            <div style="font-size:0.875rem;font-weight:500;">@row.Item2</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="wipro-card mb-4">
            <div class="card-body">
                <h6 style="font-weight:700;border-bottom:1px solid #f1f5f9;padding-bottom:0.5rem;margin-bottom:1rem;">
                    <i class="bi bi-briefcase me-2 text-primary"></i>Employment Information
                </h6>
                <div class="row g-3">
                    @foreach (var row in new[]{
                        ("Department",    e.Department),
                        ("Designation",   e.Designation),
                        ("Role",          e.Role),
                        ("Work Location", e.WorkLocation ?? "—"),
                        ("Date of Joining", e.DateOfJoining.ToString("dd MMM yyyy")),
                        ("Reporting To",  e.ReportingManagerId ?? "—")
                    })
                    {
                        <div class="col-md-6">
                            <div style="font-size:0.72rem;color:#94a3b8;font-weight:600;text-transform:uppercase;">@row.Item1</div>
                            <div style="font-size:0.875rem;font-weight:500;">@row.Item2</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="wipro-card">
            <div class="card-body">
                <h6 style="font-weight:700;border-bottom:1px solid #f1f5f9;padding-bottom:0.5rem;margin-bottom:1rem;">
                    <i class="bi bi-clock-history me-2 text-primary"></i>Record Metadata
                </h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div style="font-size:0.72rem;color:#94a3b8;font-weight:600;text-transform:uppercase;">Created At</div>
                        <div style="font-size:0.875rem;">@e.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                    <div class="col-md-6">
                        <div style="font-size:0.72rem;color:#94a3b8;font-weight:600;text-transform:uppercase;">Last Updated</div>
                        <div style="font-size:0.875rem;">@(e.UpdatedAt.HasValue ? e.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm") : "Never")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
