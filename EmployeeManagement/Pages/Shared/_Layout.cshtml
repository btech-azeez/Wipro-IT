<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Wipro Employee Portal</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Animate.css (subtle animations) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />

    <style>
        :root {
            --wipro-blue:   #4B4BF7;
            --wipro-violet: #6C3FC8;
            --wipro-dark:   #1a1a2e;
            --wipro-mid:    #16213e;
            --wipro-light:  #0f3460;
            --wipro-accent: #e94560;
            --wipro-gold:   #f7b731;
            --sidebar-w:    260px;
            --topbar-h:     64px;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background: #f0f2f7;
            color: #2d3748;
            margin: 0;
        }

        /* ─── TOP NAV ─────────────────────────────────────────────── */
        .topbar {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: var(--topbar-h);
            background: linear-gradient(135deg, var(--wipro-dark) 0%, var(--wipro-blue) 100%);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            z-index: 1030;
            box-shadow: 0 2px 20px rgba(75,75,247,0.3);
        }

        .topbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            width: var(--sidebar-w);
            flex-shrink: 0;
        }

        .wipro-logo {
            background: white;
            border-radius: 8px;
            padding: 4px 10px;
            font-weight: 800;
            font-size: 1rem;
            letter-spacing: -0.5px;
            color: var(--wipro-blue);
        }

        .wipro-logo span { color: var(--wipro-accent); }

        .topbar-title {
            color: rgba(255,255,255,0.75);
            font-size: 0.8rem;
            font-weight: 500;
            white-space: nowrap;
        }

        .topbar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-pill {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 50px;
            padding: 6px 14px 6px 6px;
            cursor: pointer;
            transition: background 0.2s;
            color: white;
            text-decoration: none;
        }

        .user-pill:hover { background: rgba(255,255,255,0.18); color: white; }

        .user-avatar {
            width: 32px; height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.8rem;
            flex-shrink: 0;
        }

        .role-badge {
            font-size: 0.65rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .role-CEO      { background: linear-gradient(135deg,#f7b731,#f39c12); color:#1a1a2e; }
        .role-HR       { background: linear-gradient(135deg,#e94560,#c0392b); color:#fff; }
        .role-Manager  { background: linear-gradient(135deg,#4B4BF7,#6C3FC8); color:#fff; }
        .role-Employee { background: linear-gradient(135deg,#20bf6b,#0a3d62); color:#fff; }

        /* ─── SIDEBAR ─────────────────────────────────────────────── */
        .sidebar {
            position: fixed;
            top: var(--topbar-h);
            left: 0;
            width: var(--sidebar-w);
            height: calc(100vh - var(--topbar-h));
            background: white;
            border-right: 1px solid #e8ecf4;
            overflow-y: auto;
            transition: transform 0.3s ease;
            z-index: 1020;
            box-shadow: 2px 0 15px rgba(0,0,0,0.05);
        }

        .sidebar-section-title {
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #a0aec0;
            padding: 1.25rem 1.25rem 0.4rem;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.65rem 1.25rem;
            color: #4a5568;
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            border-radius: 0;
            border-left: 3px solid transparent;
            transition: all 0.15s ease;
            margin: 1px 0;
        }

        .sidebar-link:hover {
            background: #f7f9ff;
            color: var(--wipro-blue);
            border-left-color: var(--wipro-blue);
        }

        .sidebar-link.active {
            background: linear-gradient(90deg, #eff0ff, #f7f9ff);
            color: var(--wipro-blue);
            border-left-color: var(--wipro-blue);
            font-weight: 600;
        }

        .sidebar-link i {
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
            flex-shrink: 0;
        }

        .sidebar-badge {
            margin-left: auto;
            font-size: 0.65rem;
            padding: 2px 7px;
            border-radius: 10px;
            background: var(--wipro-blue);
            color: white;
            font-weight: 600;
        }

        /* ─── MAIN CONTENT ───────────────────────────────────────── */
        .main-wrapper {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            min-height: calc(100vh - var(--topbar-h));
            transition: margin-left 0.3s ease;
        }

        .main-content {
            padding: 2rem;
        }

        /* ─── PAGE HEADER ─────────────────────────────────────────── */
        .page-header {
            background: white;
            border-radius: 12px;
            padding: 1.5rem 2rem;
            margin-bottom: 1.5rem;
            border: 1px solid #e8ecf4;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        .page-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
            color: var(--wipro-dark);
        }

        .page-header .breadcrumb {
            margin: 0;
            font-size: 0.8rem;
        }

        /* ─── CARDS ───────────────────────────────────────────────── */
        .wipro-card {
            background: white;
            border-radius: 12px;
            border: 1px solid #e8ecf4;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            overflow: hidden;
            transition: box-shadow 0.2s, transform 0.2s;
        }

        .wipro-card:hover { box-shadow: 0 8px 25px rgba(0,0,0,0.08); }

        .wipro-card .card-body { padding: 1.5rem; }

        /* ─── STAT CARDS ──────────────────────────────────────────── */
        .stat-card {
            border-radius: 14px;
            padding: 1.5rem;
            color: white;
            position: relative;
            overflow: hidden;
            border: none;
        }

        .stat-card::after {
            content: '';
            position: absolute;
            right: -20px; top: -20px;
            width: 100px; height: 100px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
        }

        .stat-card-icon {
            font-size: 2.5rem;
            opacity: 0.9;
        }

        .stat-card-value {
            font-size: 2.2rem;
            font-weight: 800;
            line-height: 1;
        }

        .stat-card-label {
            font-size: 0.8rem;
            font-weight: 500;
            opacity: 0.85;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* ─── BUTTONS ─────────────────────────────────────────────── */
        .btn-wipro {
            background: linear-gradient(135deg, var(--wipro-blue), var(--wipro-violet));
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            padding: 0.5rem 1.25rem;
            transition: all 0.2s;
            box-shadow: 0 4px 12px rgba(75,75,247,0.3);
        }

        .btn-wipro:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(75,75,247,0.4);
            color: white;
        }

        .btn-wipro-outline {
            background: white;
            color: var(--wipro-blue);
            border: 1.5px solid var(--wipro-blue);
            border-radius: 8px;
            font-weight: 600;
            padding: 0.5rem 1.25rem;
            transition: all 0.2s;
        }

        .btn-wipro-outline:hover {
            background: var(--wipro-blue);
            color: white;
        }

        /* ─── TABLE ───────────────────────────────────────────────── */
        .wipro-table {
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
        }

        .wipro-table thead th {
            background: #f7f9ff;
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 0.9rem 1rem;
            border-bottom: 2px solid #e8ecf4;
        }

        .wipro-table tbody td {
            padding: 1rem;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            font-size: 0.875rem;
        }

        .wipro-table tbody tr:last-child td { border-bottom: none; }

        .wipro-table tbody tr:hover { background: #fafbff; }

        /* ─── EMPLOYEE AVATAR ─────────────────────────────────────── */
        .emp-avatar {
            width: 38px; height: 38px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        /* ─── FORM ────────────────────────────────────────────────── */
        .form-control, .form-select {
            border-radius: 8px;
            border: 1.5px solid #e2e8f0;
            font-size: 0.875rem;
            padding: 0.55rem 0.9rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--wipro-blue);
            box-shadow: 0 0 0 3px rgba(75,75,247,0.12);
        }

        .form-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 0.4rem;
        }

        /* ─── TOAST ───────────────────────────────────────────────── */
        .toast-container {
            position: fixed;
            top: 76px;
            right: 20px;
            z-index: 9999;
        }

        .toast {
            border-radius: 10px;
            border: none;
            min-width: 320px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        /* ─── FOOTER ──────────────────────────────────────────────── */
        .wipro-footer {
            background: white;
            border-top: 1px solid #e8ecf4;
            padding: 1rem 2rem;
            font-size: 0.8rem;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* ─── DROPDOWN ────────────────────────────────────────────── */
        .dropdown-menu {
            border: 1px solid #e8ecf4;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
            padding: 0.5rem;
        }

        .dropdown-item {
            border-radius: 6px;
            font-size: 0.875rem;
            padding: 0.5rem 0.75rem;
            font-weight: 500;
        }

        /* ─── BADGE STATUS ────────────────────────────────────────── */
        .status-active   { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .status-inactive { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }

        /* ─── RESPONSIVE SIDEBAR ──────────────────────────────────── */
        @@media (max-width: 768px) {
            .sidebar   { transform: translateX(-100%); }
            .main-wrapper { margin-left: 0; }
            .sidebar.show { transform: translateX(0); }
            .topbar-brand { width: auto; }
        }

        /* ─── ANIMATIONS ──────────────────────────────────────────── */
        .fade-in { animation: fadeIn 0.3s ease-in; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

        /* ─── NOTIFICATION DOT ────────────────────────────────────── */
        .notif-dot {
            position: absolute;
            top: -4px;
            right: -7px;
            min-width: 18px;
            height: 18px;
            padding: 0 4px;
            border-radius: 9px;
            background: #e94560;
            color: white;
            font-size: 0.65rem;
            font-weight: 700;
            line-height: 18px;
            text-align: center;
        }

        .notification-menu {
            width: min(360px, calc(100vw - 2rem));
            max-height: 420px;
            overflow-y: auto;
        }

        .notification-item {
            padding: 0.75rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .notification-item:last-child { border-bottom: 0; }

        .notification-time {
            display: block;
            margin-top: 0.25rem;
            color: #94a3b8;
            font-size: 0.72rem;
        }
    </style>
</head>
<body>

@{
    var isAuth  = User.Identity?.IsAuthenticated == true;
    var role    = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var uname   = User.Identity?.Name ?? "";
    var fullName = User.FindFirst("FullName")?.Value ?? uname;
    var dept    = User.FindFirst("Department")?.Value ?? "";
    var initials = fullName.Split(' ').Length >= 2
                    ? $"{fullName.Split(' ')[0][0]}{fullName.Split(' ')[1][0]}"
                    : fullName.Length >= 1 ? fullName[0].ToString() : "?";

    var avatarColors = new Dictionary<string,string>
    {
        ["CEO"]      = "background:linear-gradient(135deg,#f7b731,#f39c12);color:#1a1a2e;",
        ["HR"]       = "background:linear-gradient(135deg,#e94560,#c0392b);color:#fff;",
        ["Manager"]  = "background:linear-gradient(135deg,#4B4BF7,#6C3FC8);color:#fff;",
        ["Employee"] = "background:linear-gradient(135deg,#20bf6b,#0a3d62);color:#fff;"
    };
    var avStyle = avatarColors.ContainsKey(role) ? avatarColors[role] : "background:#ccc;color:#333;";
}

<!-- ═══════════════ TOP BAR ═══════════════ -->
<div class="topbar">
    <a class="topbar-brand" asp-page="/Index">
        <div class="wipro-logo">W<span>i</span>pro</div>
        <div>
            <div style="color:white;font-weight:700;font-size:0.95rem;line-height:1.2;">Employee Portal</div>
            <div class="topbar-title">People & Culture · Enterprise System</div>
        </div>
    </a>

    <!-- hamburger for mobile -->
    <button class="btn btn-link text-white d-md-none ms-2 p-0" id="sidebarToggle">
        <i class="bi bi-list fs-4"></i>
    </button>

    <div class="topbar-right">
        @if (isAuth)
        {
            <div class="dropdown">
                <button class="btn btn-link text-white position-relative p-2" id="notificationButton" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications" title="Notifications">
                    <i class="bi bi-bell fs-5"></i>
                    <span class="notif-dot d-none" id="notificationCount">0</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end notification-menu p-0" aria-labelledby="notificationButton">
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                        <strong>Notifications</strong>
                        <span class="text-muted" id="notificationStatus" style="font-size:0.72rem;">Connecting…</span>
                    </div>
                    <div id="notificationList">
                        <div class="px-3 py-4 text-center text-muted small" id="notificationEmpty">You're all caught up.</div>
                    </div>
                </div>
            </div>

            <!-- User Dropdown -->
            <div class="dropdown">
                <a class="user-pill dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="user-avatar" style="@avStyle">@initials</span>
                    <div>
                        <div style="font-size:0.82rem;font-weight:600;line-height:1.2;">@(fullName.Length > 18 ? fullName[..18]+"…" : fullName)</div>
                        <div style="font-size:0.68rem;opacity:0.75;">@dept</div>
                    </div>
                    <span class="role-badge role-@role ms-1">@role</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" style="min-width:220px;">
                    <li class="px-3 py-2 border-bottom">
                        <div class="fw-700" style="font-weight:600;">@fullName</div>
                        <div class="text-muted" style="font-size:0.78rem;">@uname · @dept</div>
                    </li>
                    @if (role == "CEO" || role == "HR")
                    {
                        <li><a class="dropdown-item" asp-page="/Admin/Users"><i class="bi bi-people me-2 text-primary"></i>Manage Users</a></li>
                        <li><hr class="dropdown-divider"></li>
                    }
                    <li>
                        <a class="dropdown-item" asp-page="/Account/Logout">
                            <i class="bi bi-box-arrow-right me-2 text-danger"></i>Sign Out
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <a class="btn btn-wipro btn-sm" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
            </a>
        }
    </div>
</div>

<!-- ═══════════════ SIDEBAR ═══════════════ -->
@if (isAuth)
{
    <aside class="sidebar" id="sidebar">
        <!-- Dashboard -->
        <div class="sidebar-section-title">Main</div>
        <a class="sidebar-link" asp-page="/Index">
            <i class="bi bi-grid-1x2-fill"></i>Dashboard
        </a>

        <!-- Employees -->
        <div class="sidebar-section-title mt-1">Workforce</div>
        <a class="sidebar-link" asp-page="/Employees/Index">
            <i class="bi bi-people-fill"></i>@(role == "Manager" ? "My Team" : "Employee Directory")
        </a>

        @if (role == "CEO" || role == "HR" || role == "Manager")
        {
            <a class="sidebar-link" asp-page="/Employees/Create">
                <i class="bi bi-person-plus-fill"></i>Add Employee
            </a>
        }

        @if (role == "HR" || role == "CEO")
        {
            <a class="sidebar-link" asp-page="/Admin/Users">
                <i class="bi bi-shield-lock-fill"></i>User Accounts
            </a>
        }

        <!-- Dept quick-filter -->
        <div class="sidebar-section-title mt-1">Departments</div>
        @foreach (var d in new[] { ("Engineering","code-slash"), ("Human Resources","briefcase-fill"),
                                   ("Sales","graph-up"), ("Finance","currency-rupee"),
                                   ("Marketing","megaphone-fill"), ("Executive","star-fill") })
        {
            <a class="sidebar-link" asp-page="/Employees/Index" asp-route-department="@d.Item1" style="font-size:0.82rem;">
                <i class="bi bi-@d.Item2"></i>@d.Item1
            </a>
        }

        <div class="sidebar-section-title mt-1">Account</div>
        <a class="sidebar-link text-danger" asp-page="/Account/Logout">
            <i class="bi bi-power text-danger"></i>Logout
        </a>
    </aside>
}

<!-- ═══════════════ TOAST NOTIFICATIONS ═══════════════ -->
<div class="toast-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast align-items-center bg-success text-white show" role="alert">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    @TempData["SuccessMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast align-items-center bg-danger text-white show" role="alert">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    @TempData["ErrorMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
</div>

<!-- ═══════════════ MAIN WRAPPER ═══════════════ -->
<div class="@(isAuth ? "main-wrapper" : "")">
    <main class="@(isAuth ? "main-content" : "") fade-in">
        @RenderBody()
    </main>

    @if (isAuth)
    {
        <footer class="wipro-footer">
            <span>&copy; @DateTime.Now.Year Wipro Limited. All rights reserved.</span>
            <span>Employee Management Portal &nbsp;·&nbsp; Bangalore, India</span>
        </footer>
    }
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
<script>
    // Auto-dismiss toasts
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.toast').forEach(el => {
            const t = new bootstrap.Toast(el, { delay: 5000 });
            t.show();
        });

        // Sidebar toggle (mobile)
        const toggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebar');
        if (toggle && sidebar) {
            toggle.addEventListener('click', () => sidebar.classList.toggle('show'));
        }

        // Active sidebar link highlight
        const links = document.querySelectorAll('.sidebar-link');
        const cur   = window.location.pathname;
        links.forEach(l => {
            const href = l.getAttribute('href');
            if (href && cur.startsWith(href) && href !== '/') l.classList.add('active');
            if (href === '/' && cur === '/') l.classList.add('active');
        });

        const notificationButton = document.getElementById('notificationButton');
        const notificationCount = document.getElementById('notificationCount');
        const notificationList = document.getElementById('notificationList');
        const notificationEmpty = document.getElementById('notificationEmpty');
        const notificationStatus = document.getElementById('notificationStatus');
        let unreadNotifications = 0;

        notificationButton?.addEventListener('click', () => {
            unreadNotifications = 0;
            notificationCount.textContent = '0';
            notificationCount.classList.add('d-none');
        });

        if (notificationStatus && window.signalR) {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/employee-notifications')
                .withAutomaticReconnect()
                .build();

            connection.on('EmployeeChanged', notification => {
                notificationEmpty?.classList.add('d-none');

                const item = document.createElement('div');
                item.className = 'notification-item';
                const title = document.createElement('strong');
                title.className = 'd-block';
                title.textContent = notification.title;
                const message = document.createElement('span');
                message.className = 'small text-muted';
                message.textContent = notification.message;
                const time = document.createElement('time');
                time.className = 'notification-time';
                time.dateTime = notification.createdAt;
                time.textContent = new Date(notification.createdAt).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
                item.append(title, message, time);
                notificationList.prepend(item);

                while (notificationList.querySelectorAll('.notification-item').length > 8) {
                    notificationList.lastElementChild.remove();
                }

                unreadNotifications++;
                notificationCount.textContent = unreadNotifications > 9 ? '9+' : unreadNotifications;
                notificationCount.classList.remove('d-none');
            });

            connection.onreconnecting(() => notificationStatus.textContent = 'Reconnecting…');
            connection.onreconnected(() => notificationStatus.textContent = 'Live');
            connection.onclose(() => notificationStatus.textContent = 'Offline');
            connection.start()
                .then(() => notificationStatus.textContent = 'Live')
                .catch(() => notificationStatus.textContent = 'Offline');
        }
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
