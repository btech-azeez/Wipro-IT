@page
@model EmployeeManagement.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}

@if (!User.Identity!.IsAuthenticated)
{
    <!-- ════ PUBLIC LANDING PAGE ════ -->
    <div style="min-height:100vh;background:linear-gradient(135deg,#1a1a2e 0%,#4B4BF7 100%);display:flex;align-items:center;justify-content:center;padding:2rem;">
        <div class="text-center text-white animate__animated animate__fadeIn">
            <div style="background:white;border-radius:16px;padding:8px 20px;display:inline-block;margin-bottom:2rem;">
                <span style="font-weight:800;font-size:1.8rem;color:#4B4BF7;">Wi</span><span style="font-weight:800;font-size:1.8rem;color:#e94560;">pro</span>
            </div>
            <h1 style="font-size:2.8rem;font-weight:800;line-height:1.2;">Employee Management Portal</h1>
            <p style="font-size:1.1rem;opacity:0.8;max-width:480px;margin:1rem auto;">
                Secure, role-based workforce management for Wipro's global teams.
            </p>
            <div class="d-flex gap-3 justify-content-center mt-4">
                <a asp-page="/Account/Login" class="btn btn-light btn-lg fw-700" style="border-radius:10px;font-weight:700;">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </a>
            </div>
            <div class="mt-5 d-flex gap-4 justify-content-center flex-wrap">
                @foreach (var info in new[]{("CEO","f7b731","Top-level executive access"),("HR","e94560","People & recruitment"),("Manager","4B4BF7","Team leadership"),("Employee","20bf6b","Personal portal")})
                {
                    <div style="background:rgba(255,255,255,0.1);border-radius:12px;padding:1rem 1.5rem;min-width:140px;">
                        <div style="font-weight:700;color:#@info.Item2;">@info.Item1</div>
                        <div style="font-size:0.78rem;opacity:0.75;margin-top:4px;">@info.Item3</div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    var s = Model.Stats;
    <!-- ════ AUTHENTICATED DASHBOARD ════ -->

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1><i class="bi bi-grid-1x2-fill me-2 text-primary"></i>Dashboard</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item text-muted">Wipro Portal</li>
                    <li class="breadcrumb-item active">Dashboard</li>
                </ol>
            </nav>
        </div>
        <div>
            <span class="role-badge role-@role px-3 py-2" style="font-size:0.8rem;">@role View</span>
        </div>
    </div>

    <!-- Welcome Banner -->
    <div class="wipro-card mb-4" style="background:linear-gradient(135deg,#1a1a2e,#4B4BF7);color:white;border:none;">
        <div class="card-body d-flex align-items-center gap-4">
            <div style="font-size:4rem;">
                @{
                    var emoji = role switch { "CEO" => "👑", "HR" => "🤝", "Manager" => "📋", _ => "💼" };
                }
                @emoji
            </div>
            <div>
                <h3 style="font-weight:700;margin:0;">
                    Welcome back, @(User.FindFirst("FullName")?.Value ?? User.Identity.Name)!
                </h3>
                <p style="opacity:0.8;margin:4px 0 0;">
                    @(role switch {
                        "CEO"      => "You have full access to all Wipro employee data and analytics.",
                        "HR"       => "Manage employee records and user accounts from one place.",
                        "Manager"  => "View and maintain your department's employee directory.",
                        "Employee" => "Browse the employee directory and stay up to date with team changes.",
                        _          => ""
                    })
                </p>
            </div>
        </div>
    </div>

    <!-- ─── Stat Cards Row ──────────────────────────────────────────────── -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-xl-3">
            <div class="stat-card" style="background:linear-gradient(135deg,#4B4BF7,#6C3FC8);">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-card-label">Total Workforce</div>
                        <div class="stat-card-value mt-1">@s.Total</div>
                    </div>
                    <i class="bi bi-people-fill stat-card-icon"></i>
                </div>
                <div style="font-size:0.78rem;opacity:0.75;margin-top:0.75rem;">
                    @s.Active active · @(s.Total - s.Active) inactive
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card" style="background:linear-gradient(135deg,#20bf6b,#0a3d62);">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-card-label">Active Employees</div>
                        <div class="stat-card-value mt-1">@s.Active</div>
                    </div>
                    <i class="bi bi-person-check-fill stat-card-icon"></i>
                </div>
                <div style="font-size:0.78rem;opacity:0.75;margin-top:0.75rem;">
                    Across @s.DepartmentCount departments
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card" style="background:linear-gradient(135deg,#f7b731,#f39c12);color:#1a1a2e;">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-card-label">New Joiners (30d)</div>
                        <div class="stat-card-value mt-1">@s.RecentHires</div>
                    </div>
                    <i class="bi bi-person-plus-fill stat-card-icon"></i>
                </div>
                <div style="font-size:0.78rem;opacity:0.75;margin-top:0.75rem;">
                    In the last 30 days
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card" style="background:linear-gradient(135deg,#e94560,#c0392b);">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-card-label">Departments</div>
                        <div class="stat-card-value mt-1">@s.DepartmentCount</div>
                    </div>
                    <i class="bi bi-diagram-3-fill stat-card-icon"></i>
                </div>
                <div style="font-size:0.78rem;opacity:0.75;margin-top:0.75rem;">
                    Business units
                </div>
            </div>
        </div>
    </div>

    <!-- ─── Second Row ───────────────────────────────────────────────────── -->
    <div class="row g-4 mb-4">

        <!-- Role Breakdown -->
        <div class="col-lg-6">
            <div class="wipro-card h-100">
                <div class="card-body">
                    <h5 class="fw-700 mb-4" style="font-weight:700;"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Role Breakdown</h5>
                    @foreach (var r in new[] {
                        (WiproRoles.CEO, s.CEOCount, "#f7b731"),
                        (WiproRoles.HR,  s.HRCount,  "#e94560"),
                        (WiproRoles.Manager, s.ManagerCount, "#4B4BF7"),
                        (WiproRoles.Employee, s.EmployeeCount, "#20bf6b")
                    })
                    {
                        var pct = s.Total > 0 ? (int)((double)r.Item2 / s.Total * 100) : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1" style="font-size:0.85rem;font-weight:600;">
                                <span>@r.Item1</span>
                                <span>@r.Item2 (@pct%)</span>
                            </div>
                            <div style="background:#f1f5f9;border-radius:50px;height:8px;overflow:hidden;">
                                <div style="width:@pct%;background:@r.Item3;height:100%;border-radius:50px;transition:width 1s;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Department Breakdown -->
        <div class="col-lg-6">
            <div class="wipro-card h-100">
                <div class="card-body">
                    <h5 class="fw-700 mb-4" style="font-weight:700;"><i class="bi bi-buildings-fill me-2 text-primary"></i>By Department</h5>
                    @foreach (var dept in s.DeptBreakdown.Take(6))
                    {
                        var pct2 = s.Total > 0 ? (int)((double)dept.Count / s.Total * 100) : 0;
                        <div class="mb-2 d-flex align-items-center gap-3">
                            <span style="width:130px;font-size:0.82rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@dept.Dept</span>
                            <div style="flex:1;background:#f1f5f9;border-radius:50px;height:8px;overflow:hidden;">
                                <div style="width:@pct2%;background:linear-gradient(90deg,#4B4BF7,#6C3FC8);height:100%;border-radius:50px;"></div>
                            </div>
                            <span style="width:30px;text-align:right;font-size:0.82rem;font-weight:600;">@dept.Count</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ─── CEO-only Payroll & Quick Actions ──────────────────────────── -->
    @if (role == "CEO" || role == "HR")
    {
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="wipro-card" style="background:linear-gradient(135deg,#1a1a2e,#0f3460);color:white;border:none;">
                    <div class="card-body">
                        <div style="font-size:0.75rem;font-weight:600;text-transform:uppercase;opacity:0.6;letter-spacing:0.5px;">Total Annual Payroll</div>
                        <div style="font-size:1.8rem;font-weight:800;margin-top:4px;">
                            ₹ @String.Format("{0:N0}", s.TotalPayroll)
                        </div>
                        <div style="font-size:0.78rem;opacity:0.6;margin-top:4px;">Active employees combined CTC</div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="wipro-card h-100">
                    <div class="card-body">
                        <h6 class="fw-700 mb-3" style="font-weight:700;">Quick Actions</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-page="/Employees/Create" class="btn btn-wipro btn-sm"><i class="bi bi-person-plus me-1"></i>Add Employee</a>
                            <a asp-page="/Employees/Index"  class="btn btn-wipro-outline btn-sm"><i class="bi bi-people me-1"></i>View All</a>
                            <a asp-page="/Admin/Users"       class="btn btn-wipro-outline btn-sm"><i class="bi bi-shield me-1"></i>Manage Users</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

}

@section Scripts {
    <script>
        // Animate bars on load
        document.querySelectorAll('[style*="transition:width"]').forEach(el => {
            const w = el.style.width; el.style.width = '0';
            setTimeout(() => el.style.width = w, 100);
        });
    </script>
}
