@page
@model EmployeeManagement.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wipro Employee Portal — Sign In</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            min-height: 100vh;
            display: flex;
            background: #f0f2f7;
        }

        .login-left {
            width: 55%;
            background: linear-gradient(145deg, #1a1a2e 0%, #4B4BF7 60%, #6C3FC8 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 3rem;
            position: relative;
            overflow: hidden;
        }

        .login-left::before {
            content: '';
            position: absolute;
            top: -100px; right: -100px;
            width: 400px; height: 400px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }

        .login-left::after {
            content: '';
            position: absolute;
            bottom: -60px; left: -60px;
            width: 300px; height: 300px;
            border-radius: 50%;
            background: rgba(233,69,96,0.1);
        }

        .login-right {
            width: 45%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 3rem;
            background: white;
        }

        .wipro-logo-big {
            font-size: 3rem;
            font-weight: 800;
            letter-spacing: -2px;
            color: white;
        }

        .wipro-logo-big span { color: #e94560; }

        .login-card {
            width: 100%;
            max-width: 420px;
        }

        .form-control {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 0.65rem 1rem;
            font-size: 0.9rem;
        }

        .form-control:focus {
            border-color: #4B4BF7;
            box-shadow: 0 0 0 3px rgba(75,75,247,0.12);
        }

        .btn-login {
            background: linear-gradient(135deg, #4B4BF7, #6C3FC8);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 0.75rem;
            font-weight: 700;
            font-size: 1rem;
            width: 100%;
            transition: all 0.2s;
            box-shadow: 0 4px 15px rgba(75,75,247,0.3);
        }

        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(75,75,247,0.4);
            color: white;
        }

        .input-icon-wrapper { position: relative; }
        .input-icon-wrapper i {
            position: absolute;
            left: 12px; top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1rem;
        }
        .input-icon-wrapper .form-control { padding-left: 2.5rem; }

        @@media (max-width: 768px) {
            .login-left { display: none; }
            .login-right { width: 100%; padding: 2rem 1.5rem; }
        }
    </style>
</head>
<body>

<!-- Left Panel -->
<div class="login-left">
    <div class="text-center text-white position-relative" style="z-index:1;">
        <div class="wipro-logo-big">Wi<span>pro</span></div>
        <h2 style="font-weight:700;margin-top:1rem;">Employee Portal</h2>
        <p style="opacity:0.75;max-width:360px;margin:0.75rem auto;">
            Secure, role-based workforce management for Wipro's global teams across 54+ countries.
        </p>

        <div class="d-flex flex-column gap-3 mt-4">
            @foreach (var r in new[] {
                ("👑 CEO",      "Dashboard and account management", "#f7b731"),
                ("🤝 HR",       "Employee and account management",   "#e94560"),
                ("📋 Manager",  "Department employee directory",    "#7c83ff"),
                ("💼 Employee", "Employee directory access",        "#20bf6b")
            })
            {
                <div style="background:rgba(255,255,255,0.08);border-radius:10px;padding:0.75rem 1rem;text-align:left;">
                    <div style="font-weight:600;color:@r.Item3;">@r.Item1</div>
                    <div style="font-size:0.78rem;opacity:0.7;margin-top:2px;">@r.Item2</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Right Panel -->
<div class="login-right">
    <div class="login-card">
        <div class="text-center mb-4">
            <div style="display:inline-block;background:linear-gradient(135deg,#4B4BF7,#6C3FC8);border-radius:14px;padding:12px 18px;margin-bottom:1rem;">
                <i class="bi bi-shield-lock-fill text-white" style="font-size:1.8rem;"></i>
            </div>
            <h3 style="font-weight:800;color:#1a1a2e;">Welcome back</h3>
            <p style="color:#64748b;font-size:0.9rem;">Sign in to your Wipro account</p>
        </div>

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2" style="border-radius:10px;font-size:0.875rem;">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @Model.ErrorMessage
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2" style="border-radius:10px;font-size:0.875rem;">
                <i class="bi bi-check-circle-fill"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label fw-600" style="font-weight:600;font-size:0.82rem;">Wipro Username</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-person-fill"></i>
                    <input asp-for="Input.Username" class="form-control" placeholder="e.g. ceo.wipro" autocomplete="username" />
                </div>
                <span asp-validation-for="Input.Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-600" style="font-weight:600;font-size:0.82rem;">Password</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-lock-fill"></i>
                    <input asp-for="Input.Password" class="form-control" placeholder="••••••••" autocomplete="current-password" id="pwdInput" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="Input.RememberMe" class="form-check-input" id="rememberMe" />
                    <label class="form-check-label" for="rememberMe" style="font-size:0.85rem;">Remember me</label>
                </div>
            </div>

            <button type="submit" class="btn btn-login">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In to Wipro Portal
            </button>
        </form>

        <div class="text-center mt-4" style="font-size:0.82rem;color:#94a3b8;">
            New employee? <a asp-page="/Account/Register" style="color:#4B4BF7;font-weight:600;">Create account</a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
