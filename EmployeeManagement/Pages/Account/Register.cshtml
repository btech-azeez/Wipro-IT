@page
@model EmployeeManagement.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <!-- Card Header -->
            <div class="card-header bg-primary text-white text-center py-4" style="background: linear-gradient(135deg, #0f2b48 0%, #0d9488 100%) !important;">
                <div class="rounded-circle bg-white bg-opacity-20 d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px;">
                    <i class="bi bi-person-plus-fill fs-2 text-white"></i>
                </div>
                <h4 class="fw-bold mb-1">Create an Account</h4>
                <p class="text-white-50 small mb-0">Join the Employee Management Platform</p>
            </div>

            <!-- Card Body -->
            <div class="card-body p-4 p-md-5 bg-white">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2"></i>
                        <div class="small">@Model.ErrorMessage</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Username Field -->
                    <div class="mb-3">
                        <label asp-for="Input.Username" class="form-label fw-semibold small text-muted">Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-person-fill"></i>
                            </span>
                            <input asp-for="Input.Username" class="form-control border-start-0 ps-0" placeholder="Choose a unique username" autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="Input.Username" class="text-danger small"></span>
                    </div>

                    <!-- Email Field -->
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold small text-muted">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-envelope-fill"></i>
                            </span>
                            <input asp-for="Input.Email" type="email" class="form-control border-start-0 ps-0" placeholder="you@company.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold small text-muted">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input asp-for="Input.Password" type="password" class="form-control border-start-0 ps-0" placeholder="Minimum 6 characters" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold small text-muted">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-check2-circle"></i>
                            </span>
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Re-enter password" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-teal btn-lg fw-semibold shadow-sm">
                            <i class="bi bi-person-check-fill me-2"></i>Create Account
                        </button>
                    </div>
                </form>

                <!-- Login Link -->
                <div class="text-center pt-3 border-top">
                    <p class="text-muted small mb-0">
                        Already have an account?
                        <a asp-page="/Account/Login" class="text-decoration-none fw-semibold" style="color: #0d9488;">
                            Sign in here
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
