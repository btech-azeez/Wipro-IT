@page
@model EmployeeManagement.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5">
            <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center mb-4 mx-auto" style="width: 80px; height: 80px;">
                <i class="bi bi-shield-x fs-1"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
            <p class="text-muted mb-4 lead">
                You do not have the required permissions to view or perform this operation. Only authorized personnel (such as Managers or Administrators) can access this resource.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-page="/Index" class="btn btn-teal px-4">
                    <i class="bi bi-house-door me-2"></i>Return to Home
                </a>
                <a asp-page="/Employees/Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-people me-2"></i>Employee Directory
                </a>
            </div>
        </div>
    </div>
</div>
